# ── Domain (used by Caddy for HTTPS) ─────────────────────────────────────────
PINGCORD_DOMAIN=pingcord.example.com

# ── GitHub ───────────────────────────────────────────────────────────────────
# Random string, also pasted into the GitHub webhook "Secret" field.
#   openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=
# Fine-grained personal access token. Resource owner: your org.
# Organization permissions → Members: Read-only. Nothing else.
GITHUB_TOKEN=
# Your organization's login, e.g. "acme" for github.com/acme
GITHUB_ORG=

# ── Discord ──────────────────────────────────────────────────────────────────
# Channel → Edit Channel → Integrations → Webhooks → Copy Webhook URL
DISCORD_WEBHOOK_URL=
# Discord Developer Portal → your application → General Information
DISCORD_APP_ID=
DISCORD_PUBLIC_KEY=
# Developer Portal → your application → Bot → Reset Token
# (only used to register the /admin commands)
DISCORD_BOT_TOKEN=
# Right-click your server → Copy Server ID (needs Developer Mode)
DISCORD_GUILD_ID=
# Comma-separated Discord user IDs allowed to run /admin
ADMIN_DISCORD_IDS=

# ── Optional ─────────────────────────────────────────────────────────────────
# IGNORE_BOTS=true          # skip events from bots and never ping bots
# LOG_LEVEL=info            # debug | info | warn | error
# GITHUB_API_URL=https://api.github.com   # GitHub Enterprise: https://HOST/api/v3
